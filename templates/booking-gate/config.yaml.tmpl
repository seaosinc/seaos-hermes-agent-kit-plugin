# booking-gate — 許可された相手だけが Slack で話せるようにする設定
#
# このファイルは seaos-kit が初回だけ置く。以後は上書きしない（手で編集してよい）。
# アクセス許可の出し入れは seaos-kit guest で行う。設計は BOOKING-GATE.md。

# ゲートウェイを動かしているプロファイル。pairing の承認先もここで決まる。
profile: operator

# 許可の前後、何分まで通すか。
grace:
  before_minutes: 5
  after_minutes: 5

# 期限が切れたあと、pairing の承認だけを何分残すか。
# この間はゲート1を通るがゲート2が必ず落とすので、会話はできず
# 「終わりました」の案内だけが本人に届く。0 にすると切れた瞬間から無言になる。
notice_window_minutes: 10

# ゲスト1人あたり、1時間に何通まで受けるか。0 で無制限。
# 時間で区切っただけでは、その時間内に何百通でも投げられる。会話1通ごとに
# LLM を呼ぶので、これがそのまま費用になる。オーナーには適用しない。
max_messages_per_hour: 40

# アクセス許可表が何分古くなったら「ポーラーが死んでいる」とみなすか。
# 古い表は無効になり、オーナー以外は全員通らなくなる（fail-closed）。
stale_after_minutes: 5

# 許可と関係なく常に話せる Slack ユーザー ID。
# SLACK_ALLOWED_USERS と併用で、どちらか一方に載っていれば通る。
# ここが空でも .env 側が効くが、自分の ID は書いておくこと（締め出し防止）。
always_allow: []
#   - U01ABCDEF   # オーナー
